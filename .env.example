# Client (Vite) — publishable/anon only
VITE_SUPABASE_URL=https://pkcupqxmeftiakpzdxls.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Client → API. Dev: leave empty (Vite proxy). Prod Vercel: leave empty → uses /api
# Or set absolute URL if API is a separate deployment.
# VITE_API_URL=

# API server — never expose service_role to the browser / VITE_*
SUPABASE_URL=https://pkcupqxmeftiakpzdxls.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Browser origins allowed to call the API (comma-separated).
# Localhost + *.vercel.app are always allowed; set your custom domain here.
# CORS_ORIGIN=https://airforcedashi.vercel.app

# Optional: Management API token (bootstrap tools only)
SUPABASE_TOKEN=

# --- Vercel Project → Settings → Environment Variables (Production + Preview) ---
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# CORS_ORIGIN          (custom domain, if any)
# VITE_API_URL         (only if API is not same-origin /api)
# VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY  (só se o client passar a usá-los)
#
# Schema: supabase/migrations/ → public.afd_* (API service_role only)
# Apply: npx supabase db push  |  node tools/apply-afd-migration.mjs
